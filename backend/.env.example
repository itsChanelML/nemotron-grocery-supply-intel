# backend/.env.example
# Orchaid — Python FastAPI Backend
# Copy to .env and fill in values. NEVER commit .env to GitHub.
# Stack: NVIDIA NIM (agents) + Gemini 2.5 Pro (orchestrator) + GCP (data)

# NVIDIA NIM — agent inference
# Get key at: https://build.nvidia.com
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Google Cloud — orchestrator + data
# One service account JSON covers Vertex AI, BigQuery, Document AI, Storage
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GCP_BIGQUERY_DATASET=orchaid_warehouse
GCP_DOCUMENT_AI_PROCESSOR_ID=your-processor-id
GCP_STORAGE_BUCKET=orchaid-bol-documents

# Local dev: path to service account JSON file (auto-detected by GCP SDK)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# Cloud Run / production: paste entire service account JSON contents as string
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Google Chat — Physical AI Loop 1 (Equipment dispatch)
# Setup: Google Chat space → Apps & Integrations → Webhooks → Add Webhook
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/YOUR_SPACE/messages?key=YOUR_KEY

# FDA OpenFDA — live recall data (free, no key required)
# Register at open.fda.gov for higher rate limits
FDA_API_BASE_URL=https://api.fda.gov
FDA_API_KEY=
